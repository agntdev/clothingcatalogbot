[
  {
    "name": "Мужская",
    "steps": [
      {
        "expect": [
          { "method": "answerCallbackQuery" },
          {
              "method": "editMessageText",
              "payload": {
              "text": "Раздел «Мужская». Выберите подраздел или откройте все товары.",
              "reply_markup": {
                "inline_keyboard": [[{ "text": "Все товары раздела", "callback_data": "category:list:male:1" }], [{ "text": "Назад", "callback_data": "catalog:back" }], [{ "text": "Главное меню", "callback_data": "menu:main" }]]
              }
            }
          }
        ],
        "send": {
          "callback": "category:male"
        }
      }
    ]
  }
  ,
  {
    "name": "invalid catalogue page returns nearest page",
    "steps": [
      {
        "send": { "callback": "category:page:male:99" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "В этой категории пока нет товаров. Открыта первая страница." } }
        ]
      }
    ]
  }
  ,
  {
    "name": "category navigation replaces the view and Back returns to the menu",
    "steps": [
      {
        "send": { "callback": "category:open:male" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Раздел «Мужская». Выберите подраздел или откройте все товары." } }
        ]
      },
      {
        "send": { "callback": "catalog:back" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом." } }
        ]
      }
    ]
  }
  ,
  {
    "name": "main menu is available from a subcategory list and replaces it in place",
    "steps": [
      {
        "send": { "callback": "category:open:male" },
        "expect": [
          { "method": "editMessageText", "payload": { "reply_markup": { "inline_keyboard": [[{ "text": "Все товары раздела", "callback_data": "category:list:male:1" }], [{ "text": "Назад", "callback_data": "catalog:back" }], [{ "text": "Главное меню", "callback_data": "menu:main" }]] } } }
        ]
      },
      {
        "send": { "callback": "menu:main" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом." } }
        ]
      }
    ]
  }
]
