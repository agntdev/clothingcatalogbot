[
  {
    "name": "View details",
    "steps": [
      {
        "expect": [
          { "method": "answerCallbackQuery" },
          {
              "method": "editMessageText",
              "payload": {
              "text": "Этот товар больше недоступен. Выберите другой товар в каталоге."
            }
          }
        ],
        "send": {
          "callback": "product:view:missing-product"
        }
      }
    ]
  },
  {
    "name": "product callback from a photo edits its caption without stalling",
    "steps": [
      {
        "send": {
          "update": {
            "update_id": 20,
            "callback_query": {
              "id": "photo-card",
              "from": { "id": 1, "is_bot": false, "first_name": "Test" },
              "chat_instance": "ci-1",
              "data": "product:view:missing-product",
              "message": {
                "message_id": 100,
                "date": 0,
                "chat": { "id": 1, "type": "private", "first_name": "Test" },
                "from": { "id": 42, "is_bot": true, "first_name": "TestBot" },
                "photo": [{ "file_id": "photo-id", "file_unique_id": "photo-unique", "width": 90, "height": 90 }]
              }
            }
          }
        },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageCaption", "payload": { "caption": "Этот товар больше недоступен. Выберите другой товар в каталоге." } }
        ]
      }
    ]
  }
]
