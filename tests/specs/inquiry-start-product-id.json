[
  {
    "name": "Ask about this",
    "steps": [
      {
        "expect": [
          { "method": "answerCallbackQuery" },
          {
              "method": "editMessageText",
              "payload": {
              "text": "Этот товар больше недоступен. Выберите другой товар в каталоге."
              ,"reply_markup": { "inline_keyboard": [[{ "text": "Главное меню", "callback_data": "menu:main" }]] }
            }
          }
        ],
        "send": {
          "callback": "inquiry:start:missing-product"
        }
      }
    ]
  },
  {
    "name": "optional inquiry action is acknowledged immediately",
    "steps": [
      {
        "send": { "callback": "inquiry:empty" },
        "expect": [{ "method": "answerCallbackQuery" }]
      },
      {
        "send": { "callback": "inquiry:cancel" },
        "expect": [{ "method": "answerCallbackQuery" }, { "method": "sendMessage", "payload": { "text": "Заявка отменена." } }]
      }
    ]
  }
  ,
  {
    "name": "main menu from the inquiry screen is updated in place",
    "steps": [
      {
        "send": { "callback": "menu:main" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом." } }
        ]
      }
    ]
  }
]
