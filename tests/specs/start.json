[
  {
    "name": "/start sends a persistent in-chat category menu",
    "steps": [
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом.",
              "reply_markup": {
                "inline_keyboard": [
                  [{ "text": "Мужская", "callback_data": "category:male" }],
                  [{ "text": "Женская", "callback_data": "category:female" }],
                  [{ "text": "Детская", "callback_data": "category:kids" }],
                  [{ "text": "Browse All", "callback_data": "category:all" }]
                ]
              }
            }
          },
          {
            "method": "sendMessage",
            "payload": {
              "text": "Каталог всегда можно открыть кнопкой «Меню».",
              "reply_markup": {
                "keyboard": [[{ "text": "Меню" }]],
                "resize_keyboard": true,
                "is_persistent": true
              }
            }
          }
        ]
      }
    ]
  },
  {
    "name": "menu callback is acknowledged and replaces the current view",
    "steps": [
      {
        "send": { "callback": "menu:main" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом." } }
        ]
      }
    ]
  },
  {
    "name": "persistent menu control reopens the category menu",
    "steps": [
      {
        "send": { "text": "Меню" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом." } }
        ]
      }
    ]
  }
]
