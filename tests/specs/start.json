[
  {
    "name": "/start opens the inline catalogue menu",
    "steps": [
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом.",
              "reply_markup": {
                "inline_keyboard": [
                  [{ "text": "Мужская", "callback_data": "category:open:male" }],
                  [{ "text": "Женская", "callback_data": "category:open:female" }],
                  [{ "text": "Детская", "callback_data": "category:open:kids" }],
                  [{ "text": "Все товары", "callback_data": "category:list:all:1" }]
                ]
              }
            }
          }
        ]
      }
    ]
  },
  {
    "name": "menu callback is acknowledged and replaces the current view",
    "steps": [
      {
        "send": { "callback": "menu:main" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Выберите раздел. Откройте товар и нажмите «Задать вопрос», чтобы связаться с продавцом." } }
        ]
      }
    ]
  }
]
