[
  {
    "name": "admin panel is protected when administrator access is not configured",
    "steps": [
      {
        "send": { "callback": "admin:open" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  }
  ,
  {
    "name": "category management is protected when administrator access is not configured",
    "steps": [
      {
        "send": { "callback": "admin:categories" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  },
  {
    "name": "product deletion is protected when administrator access is not configured",
    "steps": [
      {
        "send": { "callback": "admin:delete:product:missing-product" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  },
  {
    "name": "a non-admin cannot open the edit list",
    "steps": [
      {
        "send": { "callback": "admin:edit:list:1", "userId": 42 },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  },
  {
    "name": "adding a product stays protected until administrator access is configured",
    "steps": [
      {
        "send": { "callback": "admin:add" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  }
]
