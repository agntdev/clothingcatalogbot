[
  {
    "name": "catalog management is protected when owner access is not configured",
    "steps": [
      {
        "send": { "callback": "admin:open" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  }
  ,
  {
    "name": "add category is protected when owner access is not configured",
    "steps": [
      {
        "send": { "callback": "admin:category:add" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  },
  {
    "name": "product deletion is protected when owner access is not configured",
    "steps": [
      {
        "send": { "callback": "admin:product:delete:missing-product" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  },
  {
    "name": "a non-owner cannot open private inquiries",
    "steps": [
      {
        "send": { "callback": "admin:inquiries", "userId": 42 },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  },
  {
    "name": "adding a product stays protected until owner access is configured",
    "steps": [
      {
        "send": { "callback": "admin:product:add:male" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Доступ владельца пока не настроен." } }]
      }
    ]
  }
]
